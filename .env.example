# انسخ هذا الملف إلى .env محلياً أو أضف المتغيرات في Render → Environment

# سري توقيع الجلسات (غيّره في الإنتاج)
# JWT_SECRET=change-me-to-a-long-random-string

# قاعدة بيانات Postgres على Render (اختياري محلياً — بدونها يُستخدم ملف محلي)
# DATABASE_URL=postgres://...

# تسجيل الدخول بجوجل — من Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins:
#   https://hci-1-fk7w.onrender.com
#   http://localhost:3000
GOOGLE_CLIENT_ID=
